# Required for Sofia AI Assistant (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Required for sending emails (Resend)
RESEND_API_KEY=your_resend_api_key_here

# Target email to receive lead notifications (Defaults to debproservices@canalrose.be)
NOTIFICATION_EMAIL=debproservices@canalrose.be

# Sender email for Resend (Must be verified in Resend if using custom domain, or your Resend account email)
RESEND_FROM_EMAIL=DEB PRO SERVICES <onboarding@resend.dev>

# Optional Google Apps Script Web App URL to receive lead entries in Google Sheets
GOOGLE_SCRIPT_URL=

# IndexNow API key for instant search engine indexing
INDEXNOW_KEY=acf19149f06a4bfe89fdf7c8fa7d602b
